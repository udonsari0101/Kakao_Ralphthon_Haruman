<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose paints the app; this theme supplies only the native launch/window frame. -->
    <style name="Theme.Haruman_Ralphthon" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#FAF9F9</item>
        <item name="android:colorBackground">#FAF9F9</item>
        <item name="android:colorAccent">@color/haruman_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- API 24-26 cannot draw dark navigation icons; keep their launch bar dark. -->
        <item name="android:navigationBarColor">#202124</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
