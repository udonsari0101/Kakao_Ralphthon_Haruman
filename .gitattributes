* text=auto
*.md text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.tsx text eol=lf
*.ts text eol=lf
*.css text eol=lf
**/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# Preserve the exact bytes used by each immutable release's SHA256SUMS.
/releases/*/manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/releases/*/release-notes.md -text
/releases/*/qa-summary.md -text
/releases/*/SHA256SUMS.txt -text
/releases/*/publication.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
